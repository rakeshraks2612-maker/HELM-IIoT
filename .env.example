# =====================================================================
# HELM-IIoT INDUSTRIAL ENVIRONMENT CONFIGURATION
# =====================================================================

HELM_ENVIRONMENT=development
HELM_DEBUG=false
HELM_LOG_LEVEL=INFO

# Service Network Bindings
HELM_GATEWAY_HOST=0.0.0.0
HELM_GATEWAY_PORT=8001
HELM_INGESTION_HOST=0.0.0.0
HELM_INGESTION_PORT=8002
HELM_ML_SERVICE_HOST=0.0.0.0
HELM_ML_SERVICE_PORT=8003
HELM_CONTROL_SERVICE_HOST=0.0.0.0
HELM_CONTROL_SERVICE_PORT=8004
HELM_SCADA_UI_PORT=8505
HELM_METRICS_PORT=9090

# Security
HELM_API_KEY=helm-sec-key-industrial-2026
HELM_JWT_SECRET=helm-jwt-secret-deterministic-tsn-994
HELM_ENABLE_AUTH=true

# SLA & Control Thresholds
HELM_SLA_LATENCY_THRESHOLD_MS=60.0
HELM_TRAFFIC_SHEDDING_FACTOR=0.82
HELM_THROTTLING_TEMP_THRESHOLD_CELSIUS=68.0
HELM_FAILOVER_DROP_THRESHOLD_PCT=1.8
HELM_MITIGATION_DEBOUNCE_SEC=5.0

# Edge Intelligence & Clustering
HELM_DBSCAN_EPS=0.30
HELM_DBSCAN_MIN_SAMPLES=8
HELM_MODEL_WEIGHTS_PATH=predictive_edge_engine.json
HELM_DRIFT_PSI_THRESHOLD=0.20
HELM_FEATURE_WINDOW_SEC=30
HELM_ROLLING_BUFFER_CAPACITY=1000

# Hardware & Protocol Endpoints
HELM_NETWORK_INTERFACE=eth0
HELM_TARGET_PROBE_HOST=127.0.0.1
HELM_TARGET_PROBE_PORT=8003
HELM_MQTT_BROKER_HOST=127.0.0.1
HELM_MQTT_BROKER_PORT=1883
HELM_MODBUS_SERVER_HOST=127.0.0.1
HELM_MODBUS_SERVER_PORT=5020
HELM_OPCUA_SERVER_URL=opc.tcp://127.0.0.1:4840/freeopcua/server/
